// hybrid   inheritance -- diamond  problem solution
#include <iostream>
using namespace std;
class A{
public:
void print(){
    cout<<"hi there.."<<"\n";
}
};
class B: virtual public A{
    //no logic
};
class C: virtual public A{
    //no logic
};
class D :public B,public C{
    //no logic
};
int main(){
    D obj1;
    obj1.print();
}



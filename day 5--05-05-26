//program 5 
// function overloading

#include <iostream>
using namespace std;
int add(int a,int b){
    return a+b;
    
}
int add(double a,double b){
    return a+b;
}
int add(int a,int b ,int c){
    return a-b*c;
    
}
float add(float a, float b ,float c,float d){
    return a-b+c+d;
    
}
int main(){
    cout<<add(2,3)<<"\n";
    cout<<add(4.4,45.5)<<"\n";
    cout<<add(2,54,34)<<"\n";
    cout<<add(5.7,4.4,4.5,34.9)<<"\n";
}

//problem--1 
// function overriding 
// same function name---same parameters -- different classes

#include <iostream>
using namespace std;
 class Appliance{
    public:
virtual void turnon(){
        cout<<"appliance is getting turn on..."<<"\n";
        
    }
    virtual  void work()=0;//this is pure vortual function
};
class Fan:public Appliance{
    public:
void turnon() override{
    cout<<"fan blades are moving slowly.."<<"\n";
}
public:
  void work() override{
      cout<<" once fan starts at full speedmit give cool air .."<<"\n";
  }  
};
class Tooster: public Appliance{
    public:
   void work() override{
       cout<<"Tooster is heating up the breads.."<<"\n";
   } 
};

int main()
{ Fan myfan;
Appliance* kitchenApp;
kitchenApp=&myfan;
kitchenApp->turnon();
kitchenApp->work();

Tooster myToast;
kitchenApp=&myToast;
kitchenApp->turnon();
kitchenApp->work();
    
    
}



1//problem   climbStairs

class Solution {
public:

    int climbStairs(int n)
    {
        // Base cases
        if(n == 0 || n == 1)
        {
            return 1;
        }

        if(n == 2)
        {
            return 2;
        }

        // Recursive call
        return climbStairs(n - 1) + climbStairs(n - 2);
    }
};




